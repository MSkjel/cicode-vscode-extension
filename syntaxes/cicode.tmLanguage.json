{
  "name": "Cicode",
  "scopeName": "source.cicode",
  "fileTypes": ["ci"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#fields" },
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#function" },
        { "include": "#format" },
        { "include": "#keywords" },
        { "include": "#labels" },
        { "include": "#numbers" },
        { "include": "#calls" },
        { "include": "#operators" },
        { "include": "#names" }
      ]
    },
    "body": {
      "patterns": [
        { "include": "#fields" },
        { "include": "#blocks" },
        { "include": "#code" }
      ]
    },
    "fields": {
      "patterns": [
        {
          "comment": "Field of a tag reference (Tag.Field, A.B.C), keywords included: Tag.End is not END.",
          "match": "(?<=[0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9})\\]])\\.([A-Za-z_\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}][0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]*)",
          "captures": { "1": { "name": "variable.other.property.cicode" } }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.xml-documentation.cicode",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.cicode" }
          },
          "patterns": [
            {
              "match": "(?i)([@\\\\]param(?:\\[(?:in|out)\\])?)[ \\t]+([A-Za-z_\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}][0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]*)[ \\t]*(.*?)(?=\\*/|$)",
              "captures": {
                "1": { "name": "entity.other.attribute-name.xml" },
                "2": { "name": "variable.other.cicode" },
                "3": { "name": "comment.doc.text.cicode" }
              }
            },
            {
              "match": "(?i)([@\\\\]short|[@\\\\]brief|[@\\\\]returns?)\\s+(.*?)(?=\\*/|$)",
              "captures": {
                "1": { "name": "entity.other.attribute-name.xml" },
                "2": { "name": "comment.doc.text.cicode" }
              }
            },
            {
              "name": "entity.name.tag.doc.xml.cicode",
              "match": "</?[A-Za-z0-9:_-]+"
            },
            { "name": "entity.name.tag.doc.xml.cicode", "match": "/?>" },
            {
              "name": "entity.other.attribute-name.xml",
              "match": "\\b[A-Za-z0-9:_-]+(?==)"
            },
            {
              "name": "variable.parameter.doc.xml.cicode",
              "match": "\"[^\"]*\""
            }
          ]
        },
        {
          "name": "comment.block.cicode",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.cicode" }
          }
        },
        {
          "name": "comment.line.documentation.cicode",
          "match": "^(\\s*///\\s*)(<)(summary|param|returns)(?:\\s+(name)(\\s*=\\s*)(\")([^\"]*)(\"))?(\\s*)(>)([^<]*?)(</)(\\3)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.comment.cicode" },
            "2": { "name": "punctuation.definition.tag.open.xml.cicode" },
            "3": { "name": "entity.name.tag.doc.xml.cicode" },
            "4": { "name": "entity.other.attribute-name.doc.xml.cicode" },
            "5": { "name": "punctuation.separator.key-value.xml.cicode" },
            "6": { "name": "punctuation.definition.string.begin.xml.cicode" },
            "7": { "name": "variable.parameter.doc.xml.cicode" },
            "8": { "name": "punctuation.definition.string.end.xml.cicode" },
            "10": { "name": "punctuation.definition.tag.open.xml.cicode" },
            "11": { "name": "comment.doc.text.cicode" },
            "12": { "name": "punctuation.definition.tag.close.xml.cicode" },
            "13": { "name": "entity.name.tag.doc.xml.cicode" },
            "14": { "name": "punctuation.definition.tag.close.xml.cicode" }
          }
        },
        {
          "name": "comment.block.documentation.cicode",
          "begin": "^(\\s*///\\s*)(<)(summary|returns)(\\s*>\\s*)$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.cicode" },
            "2": { "name": "punctuation.definition.tag.open.xml.cicode" },
            "3": { "name": "entity.name.tag.doc.xml.cicode" },
            "4": { "name": "punctuation.definition.tag.open.xml.cicode" }
          },
          "comment": "an unclosed block ends at the first line that is not a /// line",
          "end": "^(\\s*///\\s*)(</)(summary|returns)(>)\\s*$|^(?!\\s*///)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.comment.cicode" },
            "2": { "name": "punctuation.definition.tag.close.xml.cicode" },
            "3": { "name": "entity.name.tag.doc.xml.cicode" },
            "4": { "name": "punctuation.definition.tag.close.xml.cicode" }
          },
          "patterns": [
            {
              "name": "comment.line.documentation.cicode",
              "match": "^(\\s*///\\s*)(.*)$",
              "captures": {
                "1": { "name": "punctuation.definition.comment.cicode" },
                "2": { "name": "comment.doc.text.cicode" }
              }
            }
          ]
        },
        {
          "name": "comment.line.documentation.cicode",
          "match": "^(\\s*///\\s*)(?!<)(.+)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.cicode" },
            "2": { "name": "comment.doc.text.cicode" }
          }
        },
        {
          "name": "comment.line.cicode",
          "match": "(//|!).*",
          "captures": {
            "1": { "name": "punctuation.definition.comment.cicode" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cicode",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.cicode" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.cicode" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.cicode",
              "match": "\\^0[xX][0-9A-Fa-f]{2}"
            },
            {
              "name": "constant.character.escape.cicode",
              "match": "\\^[\\s\\S]"
            }
          ]
        }
      ]
    },
    "function": {
      "patterns": [
        {
          "name": "meta.function.cicode",
          "begin": "(?i)(?:(private|public)\\s+)?(?:(int|real|string|object|quality|timestamp)\\s+)?(function)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])",
          "beginCaptures": {
            "1": { "name": "storage.modifier.cicode" },
            "2": { "name": "storage.type.cicode" },
            "3": { "name": "keyword.declaration.function.cicode" }
          },
          "end": "(?i)(end)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])|(?=(?i:(?:(?:private|public)\\s+)?(?:(?:int|real|string|object|quality|timestamp)\\s+)?function)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]))",
          "endCaptures": {
            "1": { "name": "keyword.declaration.function.cicode" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "begin": "(?!(?i:end)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]))([A-Za-z_\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}][0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]*)",
              "beginCaptures": {
                "1": { "name": "entity.name.function.cicode" }
              },
              "end": "(?=(?i:end|(?:(?:private|public)\\s+)?(?:(?:int|real|string|object|quality|timestamp)\\s+)?function)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]))",
              "patterns": [{ "include": "#body" }]
            }
          ]
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "name": "meta.block.if.cicode",
          "begin": "(?i:if)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])",
          "beginCaptures": { "0": { "name": "keyword.control.cicode" } },
          "end": "(?i)(end)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])|(?=(?i:(?:(?:private|public)\\s+)?(?:(?:int|real|string|object|quality|timestamp)\\s+)?function)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]))",
          "endCaptures": { "1": { "name": "keyword.control.cicode" } },
          "patterns": [{ "include": "#body" }]
        },
        {
          "name": "meta.block.while.cicode",
          "begin": "(?i:while)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])",
          "beginCaptures": { "0": { "name": "keyword.control.cicode" } },
          "end": "(?i)(end)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])|(?=(?i:(?:(?:private|public)\\s+)?(?:(?:int|real|string|object|quality|timestamp)\\s+)?function)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]))",
          "endCaptures": { "1": { "name": "keyword.control.cicode" } },
          "patterns": [{ "include": "#body" }]
        },
        {
          "name": "meta.block.for.cicode",
          "begin": "(?i:for)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])",
          "beginCaptures": { "0": { "name": "keyword.control.cicode" } },
          "end": "(?i)(end)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])|(?=(?i:(?:(?:private|public)\\s+)?(?:(?:int|real|string|object|quality|timestamp)\\s+)?function)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]))",
          "endCaptures": { "1": { "name": "keyword.control.cicode" } },
          "patterns": [{ "include": "#body" }]
        },
        {
          "name": "meta.block.select.cicode",
          "begin": "(?i:select)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])",
          "beginCaptures": { "0": { "name": "keyword.control.cicode" } },
          "comment": "END and SELECT may be split by comments; a split across lines is not seen",
          "end": "(?i)(end)((?:\\s|/\\*.*?\\*/)+)(select)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])|(?=(?i:(?:(?:private|public)\\s+)?(?:(?:int|real|string|object|quality|timestamp)\\s+)?function)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]))",
          "endCaptures": {
            "1": { "name": "keyword.control.cicode" },
            "2": { "patterns": [{ "include": "#comments" }] },
            "3": { "name": "keyword.control.cicode" }
          },
          "patterns": [{ "include": "#body" }]
        }
      ]
    },
    "format": {
      "patterns": [
        {
          "comment": "expr : spec, the spec may follow on a later line",
          "name": "meta.format.cicode",
          "begin": ":",
          "beginCaptures": {
            "0": { "name": "keyword.operator.format.cicode" }
          },
          "end": "(#[#0\\-]*(?:!|(?:[.s]#*)?(?:[ \\t]*(?i:eu|engunit))?))|(~)|((?:-[ \\t]*)?(?:0+[xX][0-9A-Fa-f]*|0+[bB][01]*|0+[oO][0-7]*|[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]*)?))|(?=[^\\s/!])|(?=/[^/*])",
          "endCaptures": {
            "1": { "name": "constant.other.format.cicode" },
            "2": { "name": "constant.other.format.cicode" },
            "3": { "name": "constant.other.format.cicode" }
          },
          "patterns": [{ "include": "#comments" }]
        },
        {
          "comment": "a picture is only valid after ':'",
          "name": "invalid.illegal.format.cicode",
          "match": "#[#0\\-]*(?:!|(?:[.s]#*)?(?:[ \\t]*(?i:eu|engunit))?)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cicode",
          "match": "(?i:if|then|else|while|for|to|do|select|case|is|return|end)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])"
        },
        {
          "name": "keyword.operator.word.cicode",
          "match": "(?i:and|or|not|mod|bitand|bitor|bitxor)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])"
        },
        {
          "name": "storage.modifier.cicode",
          "match": "(?i:global|module|private|public)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])"
        },
        {
          "name": "storage.type.cicode",
          "match": "(?i:int|real|string|object|quality|timestamp)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])"
        },
        {
          "comment": "reserved, but not valid in .ci code",
          "name": "invalid.illegal.reserved.cicode",
          "match": "(?i:nop|var|cicode|civba)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "comment": "Include project labels (TRUE = 1, FALSE = 0), not keywords",
          "name": "variable.other.constant.label.cicode",
          "match": "(?i:true|false)(?![0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "invalid.illegal.numeric.hex.cicode",
          "match": "0+[xX]0*[1-9A-Fa-f][0-9A-Fa-f]{8,}"
        },
        {
          "name": "constant.numeric.hex.cicode",
          "match": "0+[xX][0-9A-Fa-f]*"
        },
        {
          "name": "invalid.illegal.numeric.binary.cicode",
          "match": "0+[bB]0*1[01]{32,}"
        },
        { "name": "constant.numeric.binary.cicode", "match": "0+[bB][01]*" },
        {
          "name": "invalid.illegal.numeric.octal.cicode",
          "match": "0+[oO]0*(?:[1-7][0-7]{11,}|[4-7][0-7]{10})"
        },
        { "name": "constant.numeric.octal.cicode", "match": "0+[oO][0-7]*" },
        {
          "name": "constant.numeric.cicode",
          "match": "[0-9]+(?:\\.[0-9]*(?:[eE][+-]?[0-9]*)?|[eE][+-]?[0-9]*)"
        },
        {
          "comment": "integers above 4294967295; before b, o or x the compiler splits the digits instead",
          "name": "invalid.illegal.numeric.cicode",
          "match": "0*(?:[1-9][0-9]{10,}|[5-9][0-9]{9}|4[3-9][0-9]{8}|429[5-9][0-9]{6}|42949[7-9][0-9]{4}|429496[89][0-9]{3}|4294967[3-9][0-9]{2}|429496729[6-9])(?![0-9bBoOxX])"
        },
        { "name": "constant.numeric.cicode", "match": "[0-9]+" }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "meta.function-call.cicode",
          "match": "([A-Za-z_\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}][0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]*)(?=\\s*\\()",
          "captures": { "1": { "name": "entity.name.function.call.cicode" } }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "invalid.illegal.operator.cicode",
          "match": "==|=<|=>|><"
        },
        {
          "name": "keyword.operator.comparison.cicode",
          "match": "<>|<=|>=|<|>"
        },
        { "name": "keyword.operator.cicode", "match": "=" },
        { "name": "keyword.operator.arithmetic.cicode", "match": "[-+*/]" },
        { "name": "punctuation.separator.comma.cicode", "match": "," },
        { "name": "punctuation.terminator.statement.cicode", "match": ";" },
        {
          "comment": "characters no Cicode construct accepts",
          "name": "invalid.illegal.character.cicode",
          "match": "[{}'`%&$@?~^|\\\\]"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "variable.other.cicode",
          "match": "[A-Za-z_\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}][0-9A-Za-z_\\\\\\x{AA}\\x{B5}\\x{BA}\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{FF}\\x{152}\\x{153}\\x{160}\\x{161}\\x{178}\\x{17D}\\x{17E}\\x{192}\\x{B2}\\x{B3}\\x{B9}]*"
        }
      ]
    }
  }
}
