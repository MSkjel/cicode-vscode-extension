{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "wordPattern": "0+[xX][0-9A-Fa-f]*|0+[bB][01]*|0+[oO][0-7]*|[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]*)?|[A-Za-z_\\u00AA\\u00B5\\u00BA\\u00C0-\\u00D6\\u00D8-\\u00F6\\u00F8-\\u00FF\\u0152\\u0153\\u0160\\u0161\\u0178\\u017D\\u017E\\u0192][0-9A-Za-z_\\u00AA\\u00B5\\u00BA\\u00C0-\\u00D6\\u00D8-\\u00F6\\u00F8-\\u00FF\\u0152\\u0153\\u0160\\u0161\\u0178\\u017D\\u017E\\u0192\\u00B2\\u00B3\\u00B9\\\\]*",
  "indentationRules": {
    "increaseIndentPattern": "^(?!\\s*(?://|!))(?:.*\\b(?:[tT][hH][eE][nN]|[dD][oO])\\s*(?:(?://|!).*)?$|\\s*(?:[pP][rR][iI][vV][aA][tT][eE]\\s+|[pP][uU][bB][lL][iI][cC]\\s+)?(?:(?:[iI][nN][tT]|[rR][eE][aA][lL]|[sS][tT][rR][iI][nN][gG]|[oO][bB][jJ][eE][cC][tT]|[qQ][uU][aA][lL][iI][tT][yY]|[tT][iI][mM][eE][sS][tT][aA][mM][pP])\\s+)?[fF][uU][nN][cC][tT][iI][oO][nN]\\b|\\s*(?:[eE][lL][sS][eE]|[sS][eE][lL][eE][cC][tT]\\s+[cC][aA][sS][eE]|[cC][aA][sS][eE])\\b)",
    "decreaseIndentPattern": "^\\s*(?:[eE][nN][dD](?:\\s+[sS][eE][lL][eE][cC][tT])?|[eE][lL][sS][eE]|[cC][aA][sS][eE])\\b"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ]
}
